littlenavmap.app/Contents/PkgInfo: 
	@test -d littlenavmap.app/Contents || mkdir -p littlenavmap.app/Contents
	@$(DEL_FILE) littlenavmap.app/Contents/PkgInfo
	@echo "APPL????" > littlenavmap.app/Contents/PkgInfo
littlenavmap.app/Contents/Info.plist: 
	@test -d littlenavmap.app/Contents || mkdir -p littlenavmap.app/Contents
	@$(DEL_FILE) littlenavmap.app/Contents/Info.plist
	@plutil -convert xml1 -o - /Applications/Qt/6.5.3/macos/mkspecs/macx-clang/Info.plist.app | sed -e "s,@SHORT_VERSION@,1.0,g" -e "s,\$${QMAKE_SHORT_VERSION},1.0,g" -e "s,@FULL_VERSION@,1.0.0,g" -e "s,\$${QMAKE_FULL_VERSION},1.0.0,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" -e "s,@BUNDLEIDENTIFIER@,com.yourcompany.littlenavmap,g" -e "s,\$${PRODUCT_BUNDLE_IDENTIFIER},com.yourcompany.littlenavmap,g" -e "s,\$${MACOSX_DEPLOYMENT_TARGET},11.0,g" -e "s,\$${IPHONEOS_DEPLOYMENT_TARGET},,g" -e "s,\$${TVOS_DEPLOYMENT_TARGET},,g" -e "s,\$${WATCHOS_DEPLOYMENT_TARGET},,g" -e "s,\$${IOS_LAUNCH_SCREEN},LaunchScreen,g" -e "s,@ICON@,littlenavmap.icns,g" -e "s,\$${ASSETCATALOG_COMPILER_APPICON_NAME},littlenavmap.icns,g" -e "s,@EXECUTABLE@,littlenavmap,g" -e "s,@LIBRARY@,littlenavmap,g" -e "s,\$${EXECUTABLE_NAME},littlenavmap,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" >littlenavmap.app/Contents/Info.plist
